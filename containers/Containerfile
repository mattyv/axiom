FROM python:3.12-slim AS builder

# Install build deps for axiom-extract (Clang LibTooling)
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake ninja-build \
    llvm-dev libclang-dev clang \
    zlib1g-dev libzstd-dev \
    && rm -rf /var/lib/apt/lists/*

# Build axiom-extract
WORKDIR /build
COPY tools/axiom-extract/ ./tools/axiom-extract/
RUN cd tools/axiom-extract && \
    cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build && \
    cp build/axiom-extract /usr/local/bin/axiom-extract-clang

# Final image
FROM python:3.12-slim

# Install runtime deps for axiom-extract (needs C++ headers to parse code)
# Using libc++ instead of libstdc++ for Clang compatibility
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ \
    libclang1 libc++-dev libc++abi-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy axiom-extract-clang and Clang's builtin headers from builder
COPY --from=builder /usr/local/bin/axiom-extract-clang /usr/local/bin/
COPY --from=builder /usr/lib/llvm-19/lib/clang/ /usr/lib/llvm-19/lib/clang/

# Create non-root user
RUN useradd -m -s /bin/bash axiom
WORKDIR /home/axiom/app

# Install Python deps with CPU-only PyTorch (avoids multi-GB CUDA packages)
COPY pyproject.toml .
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir ".[full,lsp]"

# Copy app code and TOML knowledge files (NOT pre-loaded DBs)
COPY axiom/ axiom/
COPY scripts/ scripts/
COPY knowledge/ knowledge/
# Note: data/lancedb/ is NOT copied - will be created on first startup

# Fix permissions
RUN chown -R axiom:axiom /home/axiom

USER axiom

COPY --chown=axiom:axiom containers/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
